{
  "name": "aster-desktop",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Local-first connected notes and spatial thinking",
  "author": "Aster",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs && node scripts/prepare-notices.mjs",
    "test:modules": "node scripts/modules-smoke.mjs",
    "audit:publish": "node scripts/audit-publish.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "release:zip": "node scripts/release-zip.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:ecosystem": "node scripts/ecosystem-smoke.mjs",
    "test:demo": "node scripts/demo-smoke.mjs",
    "demo:export": "node scripts/export-demo.mjs"
  },
  "build": {
    "appId": "com.aster.notes",
    "productName": "Aster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@formulajs/formulajs": "^4.6.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.0",
    "echarts": "^6.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alfredo12111/Aster.git"
  },
  "homepage": "https://github.com/Alfredo12111/Aster#readme",
  "bugs": {
    "url": "https://github.com/Alfredo12111/Aster/issues"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
